# Service Configuration
PORT=8095
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration
# Option 1: Use DATABASE_URL (recommended for production)
DATABASE_URL=postgres://username:password@hostname:port/database_name?sslmode=require

# Option 2: Use individual database parameters (for development)
POSTGRES_USER=blytz
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=blytz_prod

# Redis Configuration
REDIS_URL=redis:6379
REDIS_PASSWORD=
REDIS_DB=8

# Stripe Configuration
# Get these keys from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
# Test keys (for development)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Live keys (for production - replace with actual live keys)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook Configuration
# Get this from your Stripe Dashboard: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Connect Configuration
# Get these from your Stripe Connect settings: https://dashboard.stripe.com/connect/settings
STRIPE_CONNECT_CLIENT_ID=ca_...
STRIPE_CONNECT_REDIRECT_URI=https://your-domain.com/stripe/return

# Platform Fee Configuration
# Percentage fee charged by the platform (0-100)
STRIPE_PLATFORM_FEE_PERCENT=5.0

# Payout Schedule
# Options: daily, weekly, monthly
STRIPE_PAYOUT_SCHEDULE=daily

# JWT Configuration
# This should match the JWT secret used by other services
JWT_SECRET=jwt-secret-key-change-in-production

# External Service URLs
# URLs of other microservices in the system
AUTH_SERVICE_URL=http://auth-service:8084
GATEWAY_URL=http://gateway-service:8092

# Development-specific settings
# Uncomment these for local development
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/blytz_dev
# REDIS_URL=localhost:6379
# STRIPE_CONNECT_REDIRECT_URI=http://localhost:3000/stripe/return

# Production-specific settings
# Uncomment these for production deployment
# ENVIRONMENT=production
# LOG_LEVEL=warn
# STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here
# STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_here
# STRIPE_CONNECT_CLIENT_ID=ca_your_live_connect_client_id_here
# STRIPE_CONNECT_REDIRECT_URI=https://your-production-domain.com/stripe/return
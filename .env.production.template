# ===========================================
# Blytz Live Auction Platform - Production Environment
# ===========================================
# This file is generated for production deployment
# ===========================================

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_USER=blytz
POSTGRES_PASSWORD=your_database_password_here
POSTGRES_DB=blytz_prod

# Database Connection String
DATABASE_URL=postgres://blytz:your_database_password_here@postgres:5432/blytz_prod?sslmode=disable

# ===========================================
# AUTHENTICATION SECRETS (SECURE - UPDATE WITH STRONG VALUES)
# ===========================================
JWT_SECRET=your_super_secure_256_bit_jwt_secret_key_for_production_only_32_bytes_plus
BETTER_AUTH_SECRET=your_super_secure_256_bit_better_auth_secret_key_for_production_only_32_bytes_plus
BETTER_AUTH_URL=https://api.blytz.app

# ===========================================
# FIUU PAYMENT GATEWAY CONFIGURATION (PRODUCTION)
# ===========================================
FIUU_MERCHANT_ID=your_fiuu_merchant_id_here
FIUU_VERIFY_KEY=your_fiuu_verify_key_here
FIUU_SANDBOX=false

# Fiuu API Endpoints
FIUU_API_URL=https://api.merchant.fiuu.com.my
FIUU_SANDBOX_URL=https://sandbox.merchant.fiuu.com.my

# Fiuu Callback URLs (configure in Fiuu dashboard)
FIUU_RETURN_URL=https://blytz.app/checkout/success
FIUU_NOTIFY_URL=https://api.blytz.app/api/v1/webhooks/fiuu
FIUU_CALLBACK_URL=https://api.blytz.app/api/v1/webhooks/fiuu
FIUU_CANCEL_URL=https://blytz.app/checkout/cancel

# ===========================================
# NINJAVAN LOGISTICS CONFIGURATION (PRODUCTION)
# ===========================================
NINJAVAN_CLIENT_ID=your_ninjavan_client_id_here
NINJAVAN_CLIENT_SECRET=your_ninjavan_client_secret_here
NINJAVAN_ENVIRONMENT=production
NINJAVAN_COUNTRY_CODE=my

# ===========================================
# LIVEKIT CONFIGURATION (PRODUCTION)
# ===========================================
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_URL=your_livekit_url_here
LIVEKIT_HOST=your_livekit_host_here
LIVEKIT_REDIS_URL=redis://livekit-redis:6379

# ===========================================
# STRIPE CONFIGURATION (PRODUCTION)
# ===========================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_WEBHOOK_ENDPOINT=https://api.blytz.app/webhooks/stripe

# ===========================================
# REDIS CONFIGURATION (SECURE - UPDATE WITH PASSWORD)
# ===========================================
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=your_secure_redis_password_here_32_characters_minimum
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_MAX_RETRIES=3

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
NEXT_PUBLIC_API_URL=https://api.blytz.app
NEXT_PUBLIC_APP_URL=https://blytz.app
NEXT_PUBLIC_WS_URL=wss://api.blytz.app
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.blytz.app
NEXT_PUBLIC_FIUU_SANDBOX=false

# ===========================================
# INTERNAL SERVICE URLS (Docker Network)
# ===========================================
AUTH_SERVICE_URL=http://auth-service:8085
PRODUCT_SERVICE_URL=http://product-service:8086
AUCTION_SERVICE_URL=http://auction-service:8087
ORDER_SERVICE_URL=http://order-service:8088
PAYMENT_SERVICE_URL=http://payment-service:8089
LOGISTICS_SERVICE_URL=http://logistics-service:8091
CHAT_SERVICE_URL=http://chat-service:8090
SEARCH_SERVICE_URL=http://search-service:8095
NOTIFICATION_SERVICE_URL=http://notification-service:8094
STRIPE_SERVICE_URL=http://stripe-service:8089

# ===========================================
# PRODUCTION SETTINGS
# ===========================================
NODE_ENV=production
ENVIRONMENT=production
PORT=8080
MODE=remote

# ===========================================
# SECURITY SETTINGS (PRODUCTION CONFIGURED)
# ===========================================
CORS_ORIGINS=https://blytz.app,https://www.blytz.app,https://demo.blytz.app,https://seller.blytz.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
REQUEST_SIZE_LIMIT=10485760
SECURITY_HEADERS_ENABLED=true
ENABLE_CSRF_PROTECTION=true
SESSION_SECRET=your_super_secure_256_bit_session_secret_key_for_production_only_32_bytes_plus
ENCRYPTION_KEY=your_super_secure_256_bit_encryption_key_for_production_only_32_bytes_plus

# ===========================================
# MONITORING & LOGGING
# ===========================================
LOG_LEVEL=info
DEBUG=false
ENABLE_SWAGGER=false
ENABLE_PROFILER=false

# ===========================================
# DEPLOYMENT SPECIFIC
# ===========================================
DOKPLOY_NETWORK=dokploy-network
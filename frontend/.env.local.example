# Development Environment Configuration
# Copy this file to .env.local and update values as needed

# API Configuration - Use gateway for development
NEXT_PUBLIC_API_URL=http://localhost:8092
NEXT_PUBLIC_WS_URL=ws://localhost:8092

# LiveKit Configuration
NEXT_PUBLIC_LIVEKIT_URL=wss://blytz-live-u5u72ozx.livekit.cloud

# Application Mode - Use 'remote' to connect to backend services
NODE_ENV=development
MODE=remote

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true

# Fiuu Payment Gateway
NEXT_PUBLIC_FIUU_SANDBOX=true

# Security Headers
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Performance and Monitoring
NEXT_PUBLIC_PERFORMANCE_MONITORING=false

# Rate Limiting (client-side)
NEXT_PUBLIC_RATE_LIMIT_REQUESTS=100
NEXT_PUBLIC_RATE_LIMIT_WINDOW=60000

# Cache Configuration
NEXT_PUBLIC_CACHE_DURATION=300

# WebSocket Configuration
NEXT_PUBLIC_WS_RECONNECT_ATTEMPTS=5
NEXT_PUBLIC_WS_RECONNECT_DELAY=1000

# Image Optimization
NEXT_PUBLIC_IMAGE_QUALITY=85
NEXT_PUBLIC_IMAGE_PLACEHOLDER=blur

# Development Overrides
# Use mock mode for development without backend
# MODE=mock
# NEXT_PUBLIC_API_URL=http://localhost:8080
# EXPO_PUBLIC_STRIPE_CONNECT_RETURN=https://blytz.app/connect/return

# ===========================================
# STRIPE CONNECT PLATFORM SETTINGS
# ===========================================
EXPO_PUBLIC_PLATFORM_NAME=Blytz Marketplace
EXPO_PUBLIC_PLATFORM_URL=https://blytz.app
EXPO_PUBLIC_PLATFORM_SUPPORT_EMAIL=support@blytz.app

# ===========================================
# SECURITY & COMPLIANCE
# ===========================================
EXPO_PUBLIC_ENABLE_3D_SECURE=true
EXPO_PUBLIC_ENABLE_FRAUD_DETECTION=true
EXPO_PUBLIC_ENABLE_KYC_VERIFICATION=true

# ===========================================
# DEVELOPMENT TESTING
# ===========================================
EXPO_PUBLIC_STRIPE_TEST_CARD_NUMBER=4242424242424242
EXPO_PUBLIC_STRIPE_TEST_CARD_EXP=12/25
EXPO_PUBLIC_STRIPE_TEST_CARD_CVC=123
EXPO_PUBLIC_STRIPE_TEST_CARD_ZIP=10000
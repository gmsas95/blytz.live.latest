# 🚀 BLYTZ MOBILE - STRIPE CONNECT CONFIGURATION

# ===========================================
# STRIPE CONNECT - MARKETPLACE PAYMENTS
# ===========================================
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdef123456789
EXPO_PUBLIC_STRIPE_SECRET_KEY=sk_test_51234567890abcdef123456789
EXPO_PUBLIC_STRIPE_CONNECT_CLIENT_ID=ca_test_51234567890abcdef123456789
EXPO_PUBLIC_STRIPE_WEBHOOK_SECRET=whsec_test_51234567890abcdef123456789
EXPO_PUBLIC_STRIPE_PLATFORM_ACCOUNT_ID=acct_test_51234567890abcdef123456789

# ===========================================
# MARKETPLACE CONFIGURATION
# ===========================================
EXPO_PUBLIC_PLATFORM_FEE_PERCENT=0.05
EXPO_PUBLIC_MIN_PLATFORM_FEE=50
EXPO_PUBLIC_DEFAULT_CURRENCY=usd

# ===========================================
# API ENDPOINTS - STRIPE SERVICE
# ===========================================
EXPO_PUBLIC_API_URL=http://localhost:8090
EXPO_PUBLIC_WS_URL=ws://localhost:8090

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
NODE_ENV=development
ENVIRONMENT=development

# ===========================================
# LOGGING & DEBUGGING
# ===========================================
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
ENABLE_STRIPE_LOGGING=true

# ===========================================
# FEATURE FLAGS - STRIPE
# ===========================================
ENABLE_STRIPE_PAYMENTS=true
ENABLE_STRIPE_CONNECT=true
ENABLE_MOBILE_PAYMENTS=true
ENABLE_DIGITAL_WALLETS=true

# ===========================================
# STRIPE PAYMENT METHODS (MALAYSIA)
# ===========================================
EXPO_PUBLIC_ENABLE_CARD=true
EXPO_PUBLIC_ENABLE_GRABPAY=true
EXPO_PUBLIC_ENABLE_FPX=true
EXPO_PUBLIC_ENABLE_WECHAT_PAY=true
EXPO_PUBLIC_ENABLE_APPLE_PAY=false
EXPO_PUBLIC_ENABLE_GOOGLE_PAY=false

# ===========================================
# MOBILE SPECIFIC SETTINGS
# ===========================================
EXPO_PUBLIC_CLIENT_PLATFORM=react-native
EXPO_PUBLIC_CLIENT_VERSION=1.0.0
EXPO_PUBLIC_APP_NAME=Blytz Mobile

# ===========================================
# STRIPE TEST CONFIGURATION
# ===========================================
EXPO_PUBLIC_TEST_MODE=true
EXPO_PUBLIC_TEST_EMAIL=test@blytz.app
EXPO_PUBLIC_TEST_PAYMENT_METHOD=pm_card_visa

# ===========================================
# REDIRECT URLS (DEVELOPMENT)
# ===========================================
EXPO_PUBLIC_STRIPE_SUCCESS_URL=exp://192.168.1.100:19000/payment/success
EXPO_PUBLIC_STRIPE_CANCEL_URL=exp://192.168.1.100:19000/payment/cancel
EXPO_PUBLIC_STRIPE_CONNECT_REFRESH=exp://192.168.1.100:19000/connect/refresh
EXPO_PUBLIC_STRIPE_CONNECT_RETURN=exp://192.168.1.100:19000/connect/return

# ===========================================
# REDIRECT URLS (PRODUCTION)
# ===========================================
# EXPO_PUBLIC_STRIPE_SUCCESS_URL=https://blytz.app/payment/success
# EXPO_PUBLIC_STRIPE_CANCEL_URL=https://blytz.app/payment/cancel

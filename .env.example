# ===========================================
# Blytz Live Auction Platform - Development Environment
# ===========================================
# This file is for development use only
# DO NOT USE IN PRODUCTION
# ===========================================

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_USER=blytz_dev
POSTGRES_PASSWORD=blytz_dev_password_123
POSTGRES_DB=blytz_dev

# Database Connection String
DATABASE_URL=postgres://blytz_dev:blytz_dev_password_123@localhost:5432/blytz_dev?sslmode=disable

# ===========================================
# AUTHENTICATION SECRETS (DEVELOPMENT ONLY)
# ===========================================
JWT_SECRET=dev_jwt_secret_key_32_characters_minimum
BETTER_AUTH_SECRET=dev_better_auth_secret_key_32_characters_minimum
BETTER_AUTH_URL=http://localhost:8085

# ===========================================
# REDIS CONFIGURATION (DEVELOPMENT)
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=dev_redis_password_32_characters_minimum
REDIS_DB=0

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8092
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:8092
NEXT_PUBLIC_FIUU_SANDBOX=true

# ===========================================
# INTERNAL SERVICE URLS (LOCAL DEVELOPMENT)
# ===========================================
AUTH_SERVICE_URL=http://localhost:8085
PRODUCT_SERVICE_URL=http://localhost:8086
AUCTION_SERVICE_URL=http://localhost:8087
ORDER_SERVICE_URL=http://localhost:8088
PAYMENT_SERVICE_URL=http://localhost:8089
LOGISTICS_SERVICE_URL=http://localhost:8091
CHAT_SERVICE_URL=http://localhost:8090
GATEWAY_SERVICE_URL=http://localhost:8092

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
NODE_ENV=development
ENVIRONMENT=development
PORT=8080
MODE=local

# ===========================================
# SECURITY SETTINGS (DEVELOPMENT)
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
REQUEST_SIZE_LIMIT=10485760
SECURITY_HEADERS_ENABLED=true
ENABLE_CSRF_PROTECTION=false

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug
DEBUG=true
ENABLE_SWAGGER=true
ENABLE_PROFILER=true